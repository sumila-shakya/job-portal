{
    "compilerOptions": {
        "module": "node16",
        "target": "es2020",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "moduleResolution": "node16",
        "noImplicitAny": true,
        "typeRoots": ["src/@types","node_modules/@types"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules","dist"]
}