{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "noImplicitAny": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules","dist"]
}